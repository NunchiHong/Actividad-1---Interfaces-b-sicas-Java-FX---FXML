<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.mavenproject5.PrimaryController"
      spacing="15"
      prefWidth="500"
      prefHeight="350"
      style="-fx-padding: 20;">

    <Label text="Control de Gastos Semanales"
           style="-fx-font-size: 20px;"/>

    <HBox spacing="30">
        <GridPane hgap="8" vgap="10">
            <Label text="Alimentación" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtAlimentacion" text="800" prefWidth="90" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Refrigerios" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtRefrigerios" text="300" prefWidth="90" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Transporte" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtTransporte" text="600" prefWidth="90" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Telefonía" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtTelefonia" text="50" prefWidth="90" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Otros" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtOtros" text="33" prefWidth="90" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>

        <VBox spacing="12">
            <Label text="Estadísticas"
                   style="-fx-font-size: 16px;"/>
            <Label text="Total semanal"/>
            <Label fx:id="lblTotal"
                   prefWidth="110"
                   style="-fx-border-color: gray; -fx-padding: 8;"/>
            <Label text="Gasto más alto"/>
            <Label fx:id="lblMayor"
                   prefWidth="130"
                   style="-fx-border-color: gray; -fx-padding: 8;"/>
        </VBox>
    </HBox>

    <HBox spacing="12">
        <Button text="Calcular estadísticas"
                onAction="#calcular"/>
        <Button text="Limpiar"
                onAction="#limpiar"/>
    </HBox>
</VBox>