<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.mavenproject2.PrimaryController"
      alignment="CENTER"
      spacing="12"
      prefWidth="420"
      prefHeight="500"
      style="-fx-padding: 20;">

    <Label text="Desglose de dinero"
           style="-fx-font-size: 20px;"/>

    <HBox alignment="CENTER" spacing="8">
        <Label text="Dinero:"/>
        <TextField fx:id="txtDinero"
                   text="9999"
                   prefWidth="120"/>
        <Button text="X" onAction="#limpiar"/>
        <Button text="Desglosar" onAction="#desglosar"/>
    </HBox>

    <GridPane hgap="25" vgap="8">
        <Label text="Billetes de $500" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="lbl500" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Billetes de $200" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="lbl200" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Billetes de $100" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="lbl100" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Billetes de $50" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="lbl50" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Billetes de $20" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="lbl20" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Monedas de $10" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Label fx:id="lbl10" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Monedas de $5" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <Label fx:id="lbl5" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Monedas de $2" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <Label fx:id="lbl2" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Monedas de $1" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <Label fx:id="lbl1" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
    </GridPane>
</VBox>